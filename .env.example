# ─────────────────────────────────────────────────────────────────────
# Conversational Analytics — example environment configuration
# Copy this file to `.env` and fill in real values. Do NOT commit `.env`.
# ─────────────────────────────────────────────────────────────────────

# ── LLM ──────────────────────────────────────────────────────────────
# Provider: vertexai (Google Gemini via Vertex AI) | bedrock (AWS Bedrock)
LLM_PROVIDER=vertexai
# Shared across both providers
LLM_TEMPERATURE=0.7
LLM_TOP_P=0.9

# ── LLM: Vertex AI (Google Gemini) ───────────────────────────────────
# Required when LLM_PROVIDER=vertexai. Authenticates via Application Default Credentials (ADC).
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
LLM_MODEL=gemini-2.0-flash
# LLM_MODEL=gemini-2.5-flash
LLM_REGION=us-east1
# LLM_REGION=global
# LLM_REGION=us-central1
LLM_MAX_OUTPUT_TOKENS=8192
# Options: minimal | low | medium | high (only supported by thinking-capable models)
THINKING_LEVEL=minimal
# Options: true | false
INCLUDE_THOUGHTS=false

# ── LLM: AWS Bedrock ──────────────────────────────────────────────────
# Used when LLM_PROVIDER=bedrock.
# Auth: set AWS_BEARER_TOKEN_BEDROCK (short-term Bedrock API key) in your
# environment — langchain-aws/boto3 read it automatically. Standard AWS
# credentials (AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY) also work.
# NOTE: Do NOT use `setx` for the token on Windows (it truncates >1024 chars).
#       Use: $env:AWS_BEARER_TOKEN_BEDROCK = "..."  (session) or
#       [Environment]::SetEnvironmentVariable("AWS_BEARER_TOKEN_BEDROCK","...","User")
BEDROCK_MODEL=anthropic.claude-3-haiku-20240307-v1:0
BEDROCK_REGION=us-east-1
BEDROCK_MAX_TOKENS=8192

# ── Analytics Database ────────────────────────────────────────────────
ANALYTICS_DB_HOST=localhost
ANALYTICS_DB_PORT=5433
ANALYTICS_DB_NAME=zenvyra
ANALYTICS_DB_USER=ca_agent_user
ANALYTICS_DB_PASSWORD=change-me
# Comma-separated table names to exclude (leave empty to include all)
DB_IGNORE_TABLES=
# Comma-separated table names to include (leave empty to include all; mutually exclusive with DB_IGNORE_TABLES)
DB_INCLUDE_TABLES=
# Number of sample rows shown per table in schema info (0 to disable)
DB_SAMPLE_ROWS_IN_TABLE_INFO=3
# Set to true to include views in schema info
DB_VIEW_SUPPORT=false
# Comma-separated table.column pairs to hide from the LLM (default context, no role)
DB_RESTRICT_COLUMNS=customers.email,customers.phone,customers.address,employee.email

# ── Role Based Access ─────────────────────────────────────────────────
# Roles are auto-discovered from ROLE_<NAME>=tables entries.
# 1. ADMIN — full access, no restrictions
ROLE_ADMIN=customers,orders,order_items,menu_items,menu_categories,payments,reservations,employee,shifts,inventory,ingredients,loyalty_accounts,loyalty_txn,discounts,order_discounts,location,tables,roles,recipe_items,supplier,supplier_items
ROLE_ADMIN_RESTRICT_COLUMNS=

# 2. GENERAL_MANAGER — cross-location, PII restricted
ROLE_GENERAL_MANAGER=customers,orders,order_items,menu_items,menu_categories,payments,reservations,employee,shifts,inventory,ingredients,loyalty_accounts,loyalty_txn,discounts,order_discounts,location,tables,roles
ROLE_GENERAL_MANAGER_RESTRICT_COLUMNS=customers.email,customers.phone,customers.address,employee.email

# 3. LOCATION_MANAGER — single location (via row filter)
ROLE_LOCATION_MANAGER=orders,order_items,menu_items,menu_categories,payments,reservations,employee,shifts,inventory,ingredients,location,tables
ROLE_LOCATION_MANAGER_RESTRICT_COLUMNS=employee.email
# Use | as separator when conditions contain commas
ROLE_LOCATION_MANAGER_ROW_FILTERS=orders:location_id=1|shifts:location_id=1|inventory:location_id=1|employee:location_id=1

# 4. CHEF — kitchen only
ROLE_CHEF=menu_items,menu_categories,recipe_items,ingredients,inventory
ROLE_CHEF_RESTRICT_COLUMNS=

# 5. WAITER — floor operations only
ROLE_WAITER=orders,order_items,menu_items,menu_categories,tables,reservations,customers
ROLE_WAITER_RESTRICT_COLUMNS=customers.email,customers.phone,customers.address

# 6. CASHIER — payment processing only
ROLE_CASHIER=orders,order_items,payments,discounts,order_discounts,menu_items
ROLE_CASHIER_RESTRICT_COLUMNS=

# 7. ANALYST — read-only analytics, no PII
ROLE_ANALYST=customers,orders,order_items,menu_items,menu_categories,payments,reservations,employee,shifts,inventory,ingredients,loyalty_accounts,loyalty_txn,discounts,order_discounts,location,tables,roles
ROLE_ANALYST_RESTRICT_COLUMNS=customers.email,customers.phone,customers.address,employee.email

# Path to semantic layer JSON file (leave empty to disable semantic layer)
SEMANTIC_LAYER_PATH=semantic_layer.json

# ── Long-Term Memory Database ─────────────────────────────────────────
LONG_TERM_MEMORY_DB_HOST=localhost
LONG_TERM_MEMORY_DB_PORT=5434
LONG_TERM_MEMORY_DB_NAME=agent_memory
LONG_TERM_MEMORY_DB_USER=admin_user
LONG_TERM_MEMORY_DB_PASSWORD=change-me
# Master switch for long-term memory (pgvector semantic search + conversation summary storage)
LONG_TERM_MEMORY_ENABLED=true
# Enable semantic recall at query time
MEMORY_SEMANTIC_SEARCH_ENABLED=false

# ── Embedding (pgvector semantic search) ──────────────────────────────
EMBEDDING_MODEL=text-embedding-004
EMBEDDING_DIMENSION=768
# Number of semantically similar past conversations to inject into the system prompt
MEMORY_LONG_TERM_RECALL_LIMIT=3
# Max messages from Redis short-term history to send to LLM (0 = unlimited)
MEMORY_SHORT_TERM_MESSAGE_LIMIT=0

# ── Short-Term Memory (Redis) ─────────────────────────────────────────
# Options: redis | inmemory (inmemory is for local dev only, not persistent)
SHORT_TERM_MEMORY_TYPE=redis
SHORT_TERM_MEMORY_HOST=localhost
SHORT_TERM_MEMORY_PORT=6379
SHORT_TERM_MEMORY_PASSWORD=
SHORT_TERM_MEMORY_SESSION_TTL=3600

# ── App Server ────────────────────────────────────────────────────────
APP_HOST=0.0.0.0
APP_PORT=8000
# Options: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
# Max tool call iterations before agent is forced to respond
AGENT_MAX_ITERATIONS=30
# Set to true to store the full system prompt in memory.query_log (useful for debugging)
LOG_PROMPT=false
